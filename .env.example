# ClipSmith Configuration

# Execution Device & Hardware Profile ('cuda' for laptop GPU, 'cpu' for campus JupyterLab)
DEVICE=cuda
COMPUTE_TYPE=float16
OMP_NUM_THREADS=4

# Speech-To-Text (WhisperX)
# Laptop GPU: large-v3 or medium (float16/int8)
# Campus CPU: small or medium (int8)
WHISPER_MODEL=medium
WHISPER_LANGUAGE=en

# Large Language Model (Ollama)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_NUM_CTX=8192

# Video Processing & FFmpeg
# Laptop GPU: h264_nvenc | Campus CPU: libx264
VIDEO_ENCODER=h264_nvenc
VIDEO_PRESET=p4

# Storage & Database
DATABASE_URL=sqlite:///storage/clipsmith.db
STORAGE_DIR=storage

# Web Application
FLASK_PORT=5005
FLASK_DEBUG=True
SECRET_KEY=clipsmith-dev-secret-key-2026
